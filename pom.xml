    <build>
        <defaultGoal>jetty:run</defaultGoal>
        <outputDirectory>war/WEB-INF/classes</outputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <warSourceExcludes>.gwt-tmp/**</warSourceExcludes>
                    <warSourceDirectory>war</warSourceDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>${gwt-plugin.version}</version>
                <configuration>
                    <inplace>true</inplace>
                    <module>org.geosdi.geoplatform.gui.BaseApp</module>
                    <runTarget>BaseApp.html</runTarget>
                    <warSourceDirectory>war</warSourceDirectory>
                    <disableCastChecking>true</disableCastChecking>
                    <disableClassMetadata>true</disableClassMetadata>
                    <scanRemoteServiceRelativePathAnnotation>true</scanRemoteServiceRelativePathAnnotation>
                    <hostedWebapp>${basedir}/war</hostedWebapp>
                    <incremental>false</incremental>
                    <sourceLevel>${gwt.source.level}</sourceLevel>
                    <extraJvmArgs>-Xmx4g -Xss2m -Dgwt.nowarn.legacy.tools</extraJvmArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <!--<goal>compile</goal>-->
                        </goals>
                    </execution>
                    <execution>
                        <configuration>
                            <servicePattern>**/gwt/**/*Service.java</servicePattern>
                        </configuration>
                        <id>generateAsync</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generateAsync</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Run the application using "mvn jetty:run" -->
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>${jetty-version}</version>
                <configuration>
                    <webApp>
                        <contextPath>/</contextPath>
                        <baseResource>${basedir}/war</baseResource>
                    </webApp>
                    <httpConnector>
                        <port>9393</port>
                        <idleTimeout>60000</idleTimeout>
                    </httpConnector>
                    <scan>0</scan>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-build-files</id>
                        <phase>clean</phase>
                        <configuration>
                            <target>
                                <delete dir="war/WEB-INF/lib"/>
                                <delete dir="war/baseapp"/>
                                <delete dir="war/WEB-INF/deploy"/>
                                <delete dir="war/META-INF"/>
                                <delete dir="gwt-unitCache"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
        <finalName>baseapp</finalName>
    </build>
